{
  "expo": {
    "name": "Lumina11y",
    "slug": "lumina11y",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#102a43"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Lumina needs the microphone to hear your voice commands."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#102a43"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Lumina needs the microphone to hear your voice commands."
        }
      ]
    ]
  }
}
