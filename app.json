{
  "expo": {
    "name": "Lumina11y",
    "slug": "lumina11y",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#102a43"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#102a43"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lumina11y uses your microphone to listen for voice commands.",
          "speechRecognitionPermission": "Lumina11y uses speech recognition to understand voice commands."
        }
      ]
    ]
  }
}
